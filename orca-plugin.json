{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "ork-dbclient",
  "name": "Ork DBclient",
  "version": "0.2.0",
  "description": "Explore and query PostgreSQL, MySQL, MariaDB, Percona, Microsoft SQL Server, SQLite and Redis from an Orca sidebar panel.",
  "author": {
    "name": "Corpoteg.com"
  },
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "dist/main.mjs",
  "icon": "assets/icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "Ork DBclient panel showing saved database connections, a SQL editor and a results table."
  },
  "contributes": {
    "panels": [
      {
        "id": "database-explorer",
        "title": "Database Client",
        "icon": "database",
        "entry": "dist/panel.html",
        "ui": "html"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    }
  ]
}
